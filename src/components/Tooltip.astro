---
// Tooltip.astro — Global Singleton Floating Tooltip with Precision Positioning
---

<div
  id="app-tooltip"
  class="app-tooltip fixed top-0 left-0 z-[9999] pointer-events-none select-none invisible"
  role="tooltip"
  aria-hidden="true"
  data-show="false"
  data-placement="top"
>
  <div class="tooltip-bubble relative px-3 py-1.5 rounded-lg text-[11px] sm:text-xs font-sans font-medium text-stone-200 bg-[#141518]/95 backdrop-blur-md border border-accent-gold/25 shadow-[0_8px_24px_-4px_rgba(0,0,0,0.8),0_0_12px_rgba(229,184,105,0.12)] whitespace-nowrap">
    <!-- Top specular hairline -->
    <div
      class="absolute inset-x-2 top-0 h-[1px] bg-gradient-to-r from-transparent via-accent-gold/40 to-transparent pointer-events-none"
      aria-hidden="true"
    ></div>

    <span id="app-tooltip-text" class="relative z-10 tracking-wide"></span>

    <!-- Directional Arrow Caret -->
    <div id="app-tooltip-arrow" class="tooltip-arrow absolute w-2 h-2 bg-[#141518] rotate-45 pointer-events-none" aria-hidden="true"></div>
  </div>
</div>

<style>
  /* 
    Architecture:
    #app-tooltip handles geometry (top, left) with no transform interference.
    .tooltip-bubble handles visual entrance (opacity, scale, translateY).
  */
  .app-tooltip {
    will-change: top, left;
  }

  /* Smooth glide ONLY when transitioning between adjacent triggers while already showing */
  .app-tooltip.is-gliding {
    transition:
      top var(--duration-quick, 150ms) cubic-bezier(0.22, 1, 0.36, 1),
      left var(--duration-quick, 150ms) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tooltip-bubble {
    will-change: opacity, transform;
    opacity: 0;
    transform: translateY(3px) scale(0.96);
    transition:
      opacity var(--duration-micro, 80ms) ease-out,
      transform var(--duration-micro, 80ms) ease-out;
  }

  .app-tooltip[data-show="true"] {
    visibility: visible;
  }

  .app-tooltip[data-show="true"] .tooltip-bubble {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity var(--duration-quick, 150ms) cubic-bezier(0.22, 1, 0.36, 1),
      transform var(--duration-quick, 150ms) cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Placement: Top (default) */
  .app-tooltip[data-placement="top"] .tooltip-arrow {
    bottom: -4px;
    left: var(--arrow-left, 50%);
    margin-left: -4px;
    border-right: 1px solid rgba(229, 184, 105, 0.25);
    border-bottom: 1px solid rgba(229, 184, 105, 0.25);
  }

  /* Placement: Bottom (flipped) */
  .app-tooltip[data-placement="bottom"] .tooltip-arrow {
    top: -4px;
    left: var(--arrow-left, 50%);
    margin-left: -4px;
    border-left: 1px solid rgba(229, 184, 105, 0.25);
    border-top: 1px solid rgba(229, 184, 105, 0.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .app-tooltip.is-gliding {
      transition: none !important;
    }
    .tooltip-bubble {
      transition: opacity var(--duration-micro, 80ms) linear !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    var tooltip = document.getElementById('app-tooltip');
    var tooltipText = document.getElementById('app-tooltip-text');
    var tooltipArrow = document.getElementById('app-tooltip-arrow');
    if (!tooltip || !tooltipText || !tooltipArrow) return;

    var bubble = tooltip.querySelector('.tooltip-bubble');
    var showTimeout = null;
    var currentTrigger = null;
    var APPEAR_DELAY_MS = 120; // 120ms intention delay on first hover

    var isTouchOnly = function () {
      return window.matchMedia && window.matchMedia('(hover: none)').matches;
    };

    function hideTooltip() {
      if (showTimeout) {
        clearTimeout(showTimeout);
        showTimeout = null;
      }
      currentTrigger = null;
      tooltip.classList.remove('is-gliding');
      tooltip.setAttribute('data-show', 'false');
      tooltip.setAttribute('aria-hidden', 'true');
    }

    function calculateAndApplyPosition(trigger) {
      var text = trigger.getAttribute('data-tooltip');
      if (!text) {
        hideTooltip();
        return;
      }

      tooltipText.textContent = text;

      var triggerRect = trigger.getBoundingClientRect();
      var bubbleWidth = bubble ? bubble.offsetWidth : tooltip.offsetWidth;
      var bubbleHeight = bubble ? bubble.offsetHeight : tooltip.offsetHeight;

      var viewportWidth = window.innerWidth;
      var PADDING = 12;
      var OFFSET = 10; // Spacing between trigger and tooltip bubble

      var placement = 'top';
      var top = triggerRect.top - bubbleHeight - OFFSET;

      // Vertical collision: flip to bottom if too close to viewport top (< 12px)
      if (top < PADDING) {
        placement = 'bottom';
        top = triggerRect.bottom + OFFSET;
      }

      // Horizontal centering over the trigger
      var triggerCenter = triggerRect.left + (triggerRect.width / 2);
      var left = triggerCenter - (bubbleWidth / 2);

      // Clamp horizontally within viewport
      var clampedLeft = Math.max(PADDING, Math.min(left, viewportWidth - bubbleWidth - PADDING));

      // Calculate arrow offset relative to trigger center
      var arrowLeft = Math.max(10, Math.min(triggerCenter - clampedLeft, bubbleWidth - 10));

      tooltip.style.setProperty('--arrow-left', arrowLeft + 'px');
      tooltip.style.left = clampedLeft + 'px';
      tooltip.style.top = top + 'px';
      tooltip.setAttribute('data-placement', placement);
    }

    function showTooltip(trigger) {
      if (isTouchOnly()) return;

      var isAlreadyShowing = tooltip.getAttribute('data-show') === 'true';
      currentTrigger = trigger;

      if (isAlreadyShowing) {
        // Smoothly glide across without delay when user is scrubbing between adjacent buttons
        if (showTimeout) clearTimeout(showTimeout);
        tooltip.classList.add('is-gliding');
        calculateAndApplyPosition(trigger);
      } else {
        // Initial hover: snap coordinates silently first so there is NO fly-in from (0,0)
        tooltip.classList.remove('is-gliding');
        calculateAndApplyPosition(trigger);

        if (showTimeout) clearTimeout(showTimeout);
        showTimeout = window.setTimeout(function () {
          calculateAndApplyPosition(trigger);
          tooltip.setAttribute('data-show', 'true');
          tooltip.setAttribute('aria-hidden', 'false');
        }, APPEAR_DELAY_MS);
      }
    }

    // Delegated listeners for high performance across all pages and dynamic content
    document.addEventListener('pointerover', function (e) {
      var target = e.target && e.target.closest ? e.target.closest('[data-tooltip]') : null;
      if (target && target !== currentTrigger) {
        showTooltip(target);
      }
    });

    document.addEventListener('pointerout', function (e) {
      var target = e.target && e.target.closest ? e.target.closest('[data-tooltip]') : null;
      if (target && target === currentTrigger) {
        var related = e.relatedTarget && e.relatedTarget.closest ? e.relatedTarget.closest('[data-tooltip]') : null;
        if (!related) {
          hideTooltip();
        }
      }
    });

    // Keyboard navigation (Tab focus)
    document.addEventListener('focusin', function (e) {
      var target = e.target && e.target.closest ? e.target.closest('[data-tooltip]') : null;
      if (target) {
        showTooltip(target);
      }
    });

    document.addEventListener('focusout', function (e) {
      var target = e.target && e.target.closest ? e.target.closest('[data-tooltip]') : null;
      if (target && target === currentTrigger) {
        hideTooltip();
      }
    });

    // Dismiss on scroll or Escape key
    window.addEventListener('scroll', hideTooltip, { passive: true });
    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') hideTooltip();
    });
  })();
</script>
